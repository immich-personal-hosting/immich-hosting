    {
      "id": 16,
      "type": "timeseries",
      "title": "Filesystem used %",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (nodename, mountpoint)(100 - 100 * node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs|fuse.*|nfs.*|autofs\",mountpoint!~\"/var/lib/kubelet.*|/run.*|/boot.*|/var/lib/rancher.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs|fuse.*|nfs.*|autofs\",mountpoint!~\"/var/lib/kubelet.*|/run.*|/boot.*|/var/lib/rancher.*\"} * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"})",
          "legendFormat": "{{nodename}} {{mountpoint}}",
          "refId": "A",
          "instant": false,
          "range": true
