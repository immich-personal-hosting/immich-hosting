    {
      "id": 13,
      "type": "row",
      "title": "Disk and filesystem",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Disk throughput",
      "description": "Physical devices only (md/dm excluded to avoid double counting the RAID).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (nodename)(rate(node_disk_read_bytes_total{device!~\"loop.*|ram.*|md.*|dm-.*\"}[5m]) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"})",
          "legendFormat": "{{nodename}} read",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (nodename)(rate(node_disk_written_bytes_total{device!~\"loop.*|ram.*|md.*|dm-.*\"}[5m]) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"})",
          "legendFormat": "{{nodename}} write",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
